        {
            "parameters": {
                "jsCode": "const raw = $input.first().json.content.parts[0].text\n  .replace(/```json\\n?/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst jobs = JSON.parse(raw);\n\nif (jobs.length === 0) {\n  throw new Error('No jobs found.');\n}\n\nconst scoreColor = (score) => {\n  if (score >= 80) return '#27ae60';\n  if (score >= 60) return '#f39c12';\n  return '#e74c3c';\n};\n\nconst cards = jobs.map((job, i) => {\n  const color = scoreColor(job.match_score);\n  const salary = job.salary\n    ? `<p style=\"margin:4px 0 8px;font-size:13px;color:#27ae60;font-weight:bold;\">&#x1F4B0; ${job.salary}</p>`\n    : '';\n  return `\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n  <tr>\n    <td style=\"background:#ffffff;border:1px solid #e0e0e0;border-radius:8px;padding:16px;font-family:Arial,sans-serif;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:10px;\">\n        <tr>\n          <td style=\"width:30px;vertical-align:middle;\">\n            <span style=\"background:#2c3e50;color:#ffffff;border-radius:50%;width:24px;height:24px;display:inline-block;text-align:center;line-height:24px;font-size:11px;font-weight:bold;\">${i + 1}</span>\n          </td>\n          <td style=\"vertical-align:middle;padding-left:8px;\">\n            <strong style=\"font-size:15px;color:#2c3e50;\">${job.title}</strong>\n          </td>\n          <td style=\"vertical-align:middle;text-align:right;\">\n            <span style=\"background:#3498db;color:#ffffff;padding:3px 10px;border-radius:12px;font-size:11px;\">${job.category}</span>\n          </td>\n        </tr>\n      </table>\n      <p style=\"margin:0 0 4px;color:#666666;font-size:13px;\">&#x1F3E2; <strong>${job.company}</strong> &nbsp;|&nbsp; &#x1F4CD; ${job.location}</p>\n      ${salary}\n      <p style=\"margin:8px 0 10px;font-size:13px;color:#444444;line-height:1.6;\">${job.why}</p>\n      <p style=\"margin:0 0 4px;font-size:11px;color:#999999;\">Match: <strong style=\"color:${color};\">${job.match_score}%</strong></p>\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:14px;\">\n        <tr>\n          <td style=\"background:#f0f0f0;border-radius:4px;height:6px;\">\n            <table width=\"${job.match_score}%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td style=\"background:${color};border-radius:4px;height:6px;font-size:0;line-height:0;\">&nbsp;</td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n      <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td style=\"background:#3498db;border-radius:6px;padding:9px 18px;\">\n            <a href=\"${job.url}\" style=\"color:#ffffff;font-size:13px;font-weight:bold;text-decoration:none;\">View job &rarr;</a>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>`;\n}).join('');\n\nreturn [{ json: { html: cards } }];"
            },
